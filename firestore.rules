rules_version = '2';
// sessions/{sessionId}: public photo posts with private drafts.
// Required: id, slug, title, date, location, description, isPublished,
// photos (list, <=500), createdAt and updatedAt (ISO strings).
// Optional: gps (bounded coordinates), weather, camera, covers, Drive link.
// ID, slug and createdAt are immutable. Only the configured administrator writes.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.uid == '8eI45u6PWlWlEdZ1c5qfBH0lHMW2'; }
    function optionalString(data, key, maximum) { return !(key in data) || (data[key] is string && data[key].size() <= maximum); }
    function validGps(gps) {
      return gps == null || (gps is map && gps.keys().hasAll(['latitude','longitude','source'])
        && gps.keys().hasOnly(['latitude','longitude','source'])
        && gps.latitude is number && gps.latitude >= -90 && gps.latitude <= 90
        && gps.longitude is number && gps.longitude >= -180 && gps.longitude <= 180
        && gps.source in ['exif','manual','search','demo']);
    }
    function validSession(data, id) {
      return data.keys().hasAll(['id','slug','title','date','location','description','isPublished','photos','createdAt','updatedAt'])
        && data.keys().hasOnly(['id','slug','title','date','location','description','isPublished','photos','createdAt','updatedAt','gps','weather','camera','coverImageId','coverImageUrl','gdriveFolderRef'])
        && data.id == id && data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.location is string && data.location.size() > 0 && data.location.size() <= 2000
        && data.description is string && data.description.size() <= 50000
        && data.isPublished is bool && data.photos is list && data.photos.size() <= 500
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is string && data.updatedAt.size() <= 40
        && (!('gps' in data) || validGps(data.gps))
        && optionalString(data,'weather',500) && optionalString(data,'camera',500)
        && optionalString(data,'coverImageId',200) && optionalString(data,'coverImageUrl',4000)
        && optionalString(data,'gdriveFolderRef',4000);
    }
    match /sessions/{sessionId} {
      allow get: if resource == null || isAdmin() || resource.data.isPublished == true;
      allow list: if isAdmin() || resource.data.isPublished == true;
      allow create: if isAdmin() && validSession(request.resource.data, sessionId);
      allow update: if isAdmin() && validSession(request.resource.data, sessionId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.slug == resource.data.slug;
      allow delete: if isAdmin();
    }
  }
}
