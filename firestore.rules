rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sessions collection
    match /sessions/{sessionId} {
      // Anyone can read published photo sessions
      allow read: if resource == null || resource.data.isPublished == true || request.auth != null;
      
      // Only authenticated admin can create, update, or delete sessions
      allow write: if request.auth != null;
    }
  }
}
